# =====================================================================
# BaoHanhAI - biến môi trường cho Docker Compose (dev)
# Copy file này thành .env nếu dùng PostgreSQL trong Docker:
#     Copy-Item .env.example .env
# KHÔNG commit file .env
# Lưu ý: chạy mặc định (SQLite demo) KHÔNG cần file này.
# =====================================================================

# --- PostgreSQL (tuỳ chọn, xem docker-compose.yml) ---
POSTGRES_USER=baohanh
POSTGRES_PASSWORD=baohanh_dev_pw
POSTGRES_DB=baohanh_ai
POSTGRES_PORT=5432

# --- Cổng dịch vụ ---
BACKEND_PORT=8000

# --- Trợ lý bảo hành (chạy chung start.bat) ---
CHATBOT_ENABLED=True
CHATBOT_PROVIDER=mock
# AI thật: đổi CHATBOT_PROVIDER=openai_compatible và cấu hình khóa local.
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
# AI_TIMEOUT_SECONDS=30
# CHATBOT_MAX_TURNS=20
