# =====================================================================
# Backend - bien moi truong. Copy thanh .env:  Copy-Item .env.example .env
# KHONG commit file .env
# =====================================================================

# Mặc định KHÔNG cần khai báo DATABASE_URL: hệ thống dùng CSDL SQLite demo
# tại <root>/database/baohanh_ai.db với ĐƯỜNG DẪN TUYỆT ĐỐI (xem app/config.py)
# nên chạy từ backend/, tests/ hay gốc dự án đều trỏ đúng một file CSDL.
# DATABASE_URL=sqlite:///D:/Nhom6/BaoHanhAI_Project/database/baohanh_ai.db

# Muốn dùng PostgreSQL thật: bỏ comment dòng dưới rồi chạy database/postgres_schema.sql
# DATABASE_URL=postgresql://baohanh:baohanh_dev_pw@localhost:5432/baohanh_ai

# App Settings
APP_NAME=BaoHanhAI
APP_ENV=development
PORT=8000
DEBUG=True

# ---------------------------------------------------------------------
# KT3 - AI Provider cho AI-01 (phân loại lỗi bảo hành)
#   mock (mặc định) = chạy offline 100%, không cần API key
#   auto            = dùng provider thật nếu có API key, ngược lại tự fallback về mock
# TUYỆT ĐỐI không hard-code API key trong source code.
# ---------------------------------------------------------------------
AI_PROVIDER=mock
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_TIMEOUT_SECONDS=30
# AI_MAX_CONFIDENCE_WHEN_NULL=0.40

# ---------------------------------------------------------------------
# Chatbot hỗ trợ: chạy chung FastAPI, không cần cài requirements-ai-chat.txt.
# Chỉ các biến dưới đây được module hỗ trợ bản đầu sử dụng.
CHATBOT_ENABLED=True
# mock: hiển thị “Chế độ mô phỏng”; openai_compatible: hiểu ý định, diễn đạt và kiểm chứng bằng AI thật.
# Không tự fallback nếu thiếu khóa hoặc AI lỗi.
# CHATBOT_PROVIDER=mock
# CHATBOT_MAX_TURNS=20
# CHATBOT_MAX_CONTEXT_CHARS=6000
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
# AI_TIMEOUT_SECONDS=30
# Nguồn kiến thức duy nhất: docs/SUPPORT_KNOWLEDGE.md.
# Xác minh chủ sở hữu luôn bắt buộc; không có biến cấu hình bỏ qua.
