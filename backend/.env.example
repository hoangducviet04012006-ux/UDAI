# =====================================================================
# Backend - bien moi truong. Copy thanh .env:  Copy-Item .env.example .env
# KHONG commit file .env
# =====================================================================

# Mặc định KHÔNG cần khai báo DATABASE_URL: hệ thống dùng CSDL SQLite demo
# tại <root>/database/baohanh_ai.db với ĐƯỜNG DẪN TUYỆT ĐỐI (xem app/config.py)
# nên chạy từ backend/, tests/ hay gốc dự án đều trỏ đúng một file CSDL.
# DATABASE_URL=sqlite:///D:/Nhom6/BaoHanhAI_Project/database/baohanh_ai.db

# Muốn dùng PostgreSQL thật: bỏ comment dòng dưới rồi chạy database/postgres_schema.sql
# DATABASE_URL=postgresql://baohanh:baohanh_dev_pw@localhost:5432/baohanh_ai

# App Settings
APP_NAME=BaoHanhAI
APP_ENV=development
PORT=8000
DEBUG=True

# ---------------------------------------------------------------------
# KT3 - AI Provider cho AI-01 (phân loại lỗi bảo hành)
#   mock (mặc định) = chạy offline 100%, không cần API key
#   auto            = dùng provider thật nếu có API key, ngược lại tự fallback về mock
# TUYỆT ĐỐI không hard-code API key trong source code.
# ---------------------------------------------------------------------
AI_PROVIDER=mock
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_TIMEOUT_SECONDS=30
# AI_MAX_CONFIDENCE_WHEN_NULL=0.40

# ---------------------------------------------------------------------
# KT4 - Chatbot ho tro bao hanh (LangChain RAG + LangGraph Agent)
#   P0 (hien tai): CHI la feature flag + cau hinh nen tang, chua bat RAG/Agent.
#   mock (mac dinh) = chay offline 100%, khong can API key va khong can cai
#                     backend/requirements-ai-chat.txt.
#   Thu vien AI (LangChain/LangGraph/FAISS) nam trong:
#       backend/requirements-ai-chat.txt   ->  .\dev.ps1 install-chat
# ---------------------------------------------------------------------
CHATBOT_ENABLED=True

# Provider LLM cua chatbot: mock (offline) | auto | openai | openai_compatible
# Mac dinh lay theo AI_PROVIDER neu khong khai bao rieng.
# CHATBOT_PROVIDER=mock

# Embedding cho RAG: hash (offline, tat dinh, khong can API key) | openai
# CHATBOT_EMBEDDING_PROVIDER=hash
# CHATBOT_EMBEDDING_MODEL=text-embedding-3-small

# Truy hoi & kiem soat chi phi
# CHATBOT_TOP_K=4
# CHATBOT_MAX_TURNS=20
# CHATBOT_MAX_CONTEXT_CHARS=6000

# Bat buoc xac minh chu so huu (logic BR4) truoc khi tra thong tin phieu/serial
# CHATBOT_REQUIRE_OWNER_VERIFICATION=True

# Thu muc knowledge base (markdown) va vector store cuc bo
# CHATBOT_KB_DIR=D:/Nhom6/BaoHanhAI_Project/database/knowledge
# CHATBOT_VECTOR_DIR=D:/Nhom6/BaoHanhAI_Project/database/vectorstore

# Phien ban prompt (luu vao chat_messages.prompt_version)
# CHATBOT_PROMPT_VERSION=chatbot_v1
